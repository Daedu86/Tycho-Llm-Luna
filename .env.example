# Copy to .env, replace only the keys you use, then run:
#   set -a; source .env; set +a
ARC_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Workspace execution. "auto" selects Finch or Docker.
TYCHO_SANDBOX_RUNTIME=auto
# TYCHO_SANDBOX_IMAGE=tycho-python-sandbox:0.1

# Native provider selection. Keep only one active pair at a time.
# LLM_BACKEND=anthropic
# LLM_MODEL=<anthropic-model-id>
# LLM_BACKEND=openai_responses
# LLM_MODEL=<openai-model-id>
